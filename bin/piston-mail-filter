#!/usr/bin/env python3
import email
import email.utils
import mailbox
import os
from pathlib import Path
import pwd
import re
import sys


HOME = Path.home()
MAILDIR = Path(os.environ.get("BOT_MAILDIR", str(HOME / "Maildir")))
LOG_PATH = Path(
    os.environ.get("BOT_MAIL_FILTER_LOG", str(HOME / ".local/state/piston/mail-filter.log"))
)
DOMAINS_FILE = Path(
    os.environ.get("BOT_MAIL_FILTER_DOMAINS_FILE", str(HOME / ".config/piston/mail-filter-domains.txt"))
)
REQUIRE_ALIGNED_DKIM = os.environ.get("BOT_REQUIRE_ALIGNED_DKIM", "").lower() in {"1", "true", "yes"}
AUTH_RESULTS_ID = os.environ.get("BOT_AUTH_RESULTS_ID", "").strip().lower()
TRUST_LOCAL_SUBMISSION = os.environ.get("BOT_TRUST_LOCAL_SUBMISSION", "").lower() in {"1", "true", "yes"}
LOCAL_MAIL_DOMAIN = os.environ.get("BOT_LOCAL_MAIL_DOMAIN", "").strip().lower()


def load_allowed_domains() -> set[str]:
    env_value = os.environ.get("BOT_ALLOWED_FROM_DOMAINS", "")
    if env_value.strip():
        return {
            domain.strip().lower()
            for domain in env_value.split(",")
            if domain.strip()
        }
    if DOMAINS_FILE.exists():
        domains: set[str] = set()
        for line in DOMAINS_FILE.read_text(encoding="utf-8").splitlines():
            text = line.strip().lower()
            if not text or text.startswith("#"):
                continue
            domains.add(text)
        return domains
    return set()


ALLOWED_DOMAINS = load_allowed_domains()


def sender_allowed(raw_message: bytes) -> tuple[bool, str, str]:
    msg = email.message_from_bytes(raw_message)
    from_header = msg.get("From", "")
    _, addr = email.utils.parseaddr(from_header)
    domain = addr.rsplit("@", 1)[-1].lower() if "@" in addr else ""
    sender = addr or from_header or "(missing From)"
    if not ALLOWED_DOMAINS:
        return True, sender, "allowed"
    if domain in ALLOWED_DOMAINS:
        return True, sender, "allowed"
    return False, sender, "from-domain-not-allowed"


def dkim_authenticated(raw_message: bytes) -> tuple[bool, str]:
    if not AUTH_RESULTS_ID:
        return False, "missing-auth-results-id-config"

    msg = email.message_from_bytes(raw_message)
    headers = list(msg.raw_items())
    first_received = next((index for index, (name, _) in enumerate(headers) if name.lower() == "received"), None)
    if first_received is None:
        return False, "missing-received-header"

    from_header = msg.get("From", "")
    _, addr = email.utils.parseaddr(from_header)
    from_domain = addr.rsplit("@", 1)[-1].lower() if "@" in addr else ""
    if not from_domain:
        return False, "missing-from-domain"

    # The local verifier inserts Authentication-Results above Postfix's own
    # Received header. Results supplied by an SMTP sender remain below that
    # boundary and must not be trusted.
    for index, (name, value) in enumerate(headers):
        if index >= first_received:
            break
        if name.lower() != "authentication-results":
            continue
        authserv_id, separator, results = value.partition(";")
        if not separator or authserv_id.strip().lower() != AUTH_RESULTS_ID:
            continue
        for result in re.finditer(
            r"\bdkim\s*=\s*pass\b(?P<properties>.*?)(?=\b(?:arc|auth|compauth|dkim|dmarc|iprev|spf)\s*=|$)",
            results,
            flags=re.IGNORECASE | re.DOTALL,
        ):
            signing_domain = re.search(
                r"\bheader\.d\s*=\s*([^;\s]+)",
                result.group("properties"),
                flags=re.IGNORECASE,
            )
            if signing_domain and signing_domain.group(1).strip().lower() == from_domain:
                return True, "aligned-dkim-pass"
    return False, "missing-aligned-dkim-pass"


def local_submission_authenticated(raw_message: bytes) -> tuple[bool, str]:
    if not TRUST_LOCAL_SUBMISSION or not LOCAL_MAIL_DOMAIN:
        return False, "local-submission-trust-disabled"

    msg = email.message_from_bytes(raw_message)
    first_received = next((value for name, value in msg.raw_items() if name.lower() == "received"), "")
    match = re.search(r"\(Postfix,\s+from userid\s+(\d+)\)", first_received, flags=re.IGNORECASE)
    if not match:
        return False, "missing-local-postfix-uid"

    try:
        username = pwd.getpwuid(int(match.group(1))).pw_name.lower()
    except (KeyError, ValueError):
        return False, "unknown-local-postfix-uid"

    _, addr = email.utils.parseaddr(msg.get("From", ""))
    if addr.lower() == f"{username}@{LOCAL_MAIL_DOMAIN}":
        return True, "authenticated-local-submission"
    return False, "local-submission-sender-mismatch"


def log_drop(sender: str, reason: str) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOG_PATH.open("a", encoding="utf-8") as handle:
        handle.write(f"dropped reason={reason} sender={sender}\n")


def main() -> int:
    raw_message = sys.stdin.buffer.read()
    allowed, sender, reason = sender_allowed(raw_message)
    if allowed and REQUIRE_ALIGNED_DKIM:
        allowed, reason = dkim_authenticated(raw_message)
        if not allowed:
            allowed, reason = local_submission_authenticated(raw_message)
    if allowed:
        mailbox.Maildir(str(MAILDIR), factory=None, create=True).add(raw_message)
    else:
        log_drop(sender, reason)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
