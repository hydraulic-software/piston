#!/usr/bin/env bash
set -euo pipefail

export HOME="${HOME:-$(cd ~ && pwd)}"
export USER="${USER:-$(id -un)}"
export PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"

render() {
  "${HOME}/.local/bin/piston-render-codex-monitor"
}

render_recent() {
  local today
  today=$(date +%F)
  if [[ "$today" != "$last_full_render_day" ]]; then
    render
    last_full_render_day=$today
  else
    "${HOME}/.local/bin/piston-render-codex-monitor" --recent
  fi
}

render
last_full_render_day=$(date +%F)
last_render_at=$(date +%s)
min_interval=${BOT_MONITOR_MIN_INTERVAL_SECONDS:-5}

if ! [[ "$min_interval" =~ ^[1-9][0-9]*$ ]]; then
  echo "BOT_MONITOR_MIN_INTERVAL_SECONDS must be a positive integer" >&2
  exit 2
fi

while read -r _; do
  # Coalesce write bursts before refreshing the active day. Historical days
  # are rebuilt only at startup and local-day rollover.
  while true; do
    now=$(date +%s)
    remaining=$((min_interval - (now - last_render_at)))
    if ((remaining <= 0)); then
      break
    fi
    read -r -t "$remaining" _ || break
  done
  render_recent
  last_render_at=$(date +%s)
done < <(
  inotifywait -m -r \
    -e modify,close_write,create,move,delete \
    "${HOME}/.codex/sessions" \
    "${HOME}/.local/state/piston/runs" \
    "${HOME}/.local/state/piston/todo.json"
)
