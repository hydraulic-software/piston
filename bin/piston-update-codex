#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: piston-update-codex [--check] [VERSION]

Install the Codex CLI version pinned by Piston, or an explicit exact VERSION,
into ${BOT_CODEX_INSTALL_DIR:-~/codex}. The release is staged and verified
before replacing the live tree. The prior tree is retained as a timestamped
sibling backup.

With --check, verify that the Codex command on PATH matches the expected
version without changing anything.
EOF
}

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
pin_file="${BOT_CODEX_VERSION_FILE:-${script_dir}/../config/codex-version}"
# Copy-mode installations have no release tree beside the executable.
if [[ -z "${BOT_CODEX_VERSION_FILE:-}" && ! -r "$pin_file" ]]; then
  pin_file="${HOME}/.local/share/piston/codex-version"
fi
check_only=0

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--check" ]]; then
  check_only=1
  shift
fi
if [[ $# -gt 1 ]]; then
  usage >&2
  exit 2
fi

if [[ $# -eq 1 ]]; then
  version="$1"
elif [[ -r "$pin_file" ]]; then
  version="$(tr -d '[:space:]' < "$pin_file")"
else
  echo "Piston Codex version pin not found: $pin_file" >&2
  exit 1
fi
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then
  echo "Expected an exact Codex version, got: $version" >&2
  exit 2
fi

if [[ "$check_only" == "1" ]]; then
  codex_command="${BOT_CODEX_COMMAND:-codex}"
  if ! actual_version="$("$codex_command" --version 2>/dev/null)"; then
    echo "Unable to run Codex command: $codex_command" >&2
    exit 1
  fi
  if [[ "$actual_version" != "codex-cli ${version}" ]]; then
    echo "Codex version mismatch: expected ${version}, found ${actual_version}" >&2
    exit 1
  fi
  echo "Codex version matches Piston pin: ${version}"
  exit 0
fi

install_dir="${BOT_CODEX_INSTALL_DIR:-${HOME}/codex}"
bin_link="${BOT_CODEX_BIN_LINK:-${HOME}/.local/bin/codex}"
if [[ -e "$bin_link" && ! -L "$bin_link" ]]; then
  echo "Refusing to replace non-symlink Codex command: $bin_link" >&2
  exit 1
fi
parent_dir="$(dirname "$install_dir")"
base_name="$(basename "$install_dir")"
mkdir -p "$parent_dir"

stage_dir="$(mktemp -d "${parent_dir}/.${base_name}.upgrade.XXXXXX")"
backup_dir=""
complete=0

cleanup() {
  rm -rf "$stage_dir"
  if [[ "$complete" != "1" && -n "$backup_dir" && -d "$backup_dir" ]]; then
    rm -rf "$install_dir"
    mv "$backup_dir" "$install_dir"
  fi
}
trap cleanup EXIT

printf '{"private":true}\n' >"${stage_dir}/package.json"
npm --prefix "$stage_dir" install --save-exact "@openai/codex@${version}"

staged_binary="${stage_dir}/node_modules/@openai/codex/bin/codex.js"
staged_version="$(node "$staged_binary" --version)"
if [[ "$staged_version" != "codex-cli ${version}" ]]; then
  echo "Staged Codex version mismatch: $staged_version" >&2
  exit 1
fi

if [[ -e "$install_dir" || -L "$install_dir" ]]; then
  backup_dir="${install_dir}.backup-$(date +%Y%m%d%H%M%S)"
  mv "$install_dir" "$backup_dir"
fi
mv "$stage_dir" "$install_dir"
stage_dir=""

installed_binary="${install_dir}/node_modules/@openai/codex/bin/codex.js"
installed_version="$(node "$installed_binary" --version)"
if [[ "$installed_version" != "codex-cli ${version}" ]]; then
  echo "Installed Codex version mismatch: $installed_version" >&2
  exit 1
fi

mkdir -p "$(dirname "$bin_link")"
ln -sfn "$installed_binary" "$bin_link"

complete=1
echo "Installed ${installed_version} in ${install_dir}"
echo "Selected managed command at ${bin_link}"
if [[ -n "$backup_dir" ]]; then
  echo "Previous installation retained at ${backup_dir}"
fi
