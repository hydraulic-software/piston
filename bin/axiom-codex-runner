#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
if [[ -z "${mode}" ]]; then
  echo "usage: $0 <mail|timer|nightly>" >&2
  exit 64
fi

case "${mode}" in
  mail)
    prompt="The time is $(date). You've got mail! Handle the messages identified in the mail wakeup context end-to-end if practical, and if one points at a ticket or issue treat updating that upstream thread/ticket as part of done, not optional follow-up."
    ;;
  timer)
    prompt="The time is $(date). Autonomous check-in: wake up, review the current state, and see if there is anything useful to do. Prefer finishing a chosen issue in one wakeup when practical instead of spreading it across multiple wakeups, and when issue work reaches a conclusion treat updating the relevant ticket/thread as part of completion before clearing the todo."
    ;;
  nightly)
    prompt="The time is $(date). Nightly maintenance wakeup: consolidate notes and memory, organize the home directory and thematic wiki, review the rolling todo list, and see if any safe cleanup or follow-up work should be prepared for tomorrow. Notice repeated, stable workflows that deserve a narrowly scoped new or updated skill; do not create skills merely to copy notes or wiki content."
    ;;
  *)
    echo "unknown mode: ${mode}" >&2
    exit 64
    ;;
esac

export HOME="${HOME:-$(cd ~ && pwd)}"
export USER="${USER:-$(id -un)}"
export PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"
umask 022

lock_dir="${HOME}/.local/state/axiom"
mkdir -p "${lock_dir}"
lock_file="${lock_dir}/codex.lock"
run_log_dir="${lock_dir}/runs"
mkdir -p "${run_log_dir}"

log() {
  printf '[%s] [%s] %s\n' "$(date --iso-8601=seconds)" "${mode}" "$*"
}

exec 9>"${lock_file}"
log "waiting for lock ${lock_file}"
flock 9
log "acquired lock"

if [[ "${mode}" == "mail" ]]; then
  mail_context_helper="${HOME}/.local/bin/axiom-mail-context"
  if [[ -x "${mail_context_helper}" ]]; then
    mail_context="$("${mail_context_helper}")"
    prompt+=$'\n\nMail wakeup context:\n'"${mail_context}"
    log "included exact Maildir source paths and message IDs in prompt"
  else
    log "mail context helper not found at ${mail_context_helper}"
  fi
fi

common_args=(
  --skip-git-repo-check
  --dangerously-bypass-approvals-and-sandbox
)
log "Codex sandboxing is disabled; the dedicated Unix account is the security boundary"
if [[ -n "${BOT_CODEX_MODEL:-}" ]]; then
  common_args+=(--model "${BOT_CODEX_MODEL}")
  log "using configured model ${BOT_CODEX_MODEL}"
else
  log "using the Codex default model"
fi

timestamp="$(date +%Y%m%dT%H%M%S)"
message_file="${run_log_dir}/${timestamp}-${mode}.last-message.txt"
transcript_file="${run_log_dir}/${timestamp}-${mode}.transcript.txt"
summary_file="${run_log_dir}/${timestamp}-${mode}.summary.json"
schedule_helper="${HOME}/.local/bin/axiom-autonomy-scheduler"

summarize_last_message() {
  if [[ -s "${message_file}" ]]; then
    local summary
    summary="$(tr '\n' ' ' < "${message_file}" | sed 's/[[:space:]]\+/ /g' | cut -c1-400)"
    log "final message saved to ${message_file}"
    log "full transcript saved to ${transcript_file}"
    log "final summary: ${summary}"
  else
    log "no final message was captured"
  fi
}

write_structured_summary() {
  python3 - "${mode}" "${prompt}" "${message_file}" "${transcript_file}" "${summary_file}" "${1:-0}" <<'PY'
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

mode, prompt, message_path, transcript_path, summary_path, exit_code = sys.argv[1:]
message_file = Path(message_path)
transcript_file = Path(transcript_path)
summary_file = Path(summary_path)

message = message_file.read_text(encoding="utf-8") if message_file.exists() else ""
transcript = transcript_file.read_text(encoding="utf-8", errors="replace") if transcript_file.exists() else ""
flat = " ".join(message.split())
headline = ""
if flat:
    match = re.search(r"(.+?[.!?])(?:\s|$)", flat)
    headline = (match.group(1) if match else flat)[:160]
run_error = ""
if not headline and transcript:
    error_match = re.search(r'ERROR:\s*(.+)', transcript)
    if error_match:
        run_error = error_match.group(1).strip()
        headline = f"Run failed: {run_error}"[:160]

payload = {
    "generated_at": datetime.now(timezone.utc).isoformat(),
    "mode": mode,
    "prompt": prompt,
    "headline": headline,
    "final_message": message,
    "message_file": message_file.name,
    "transcript_file": transcript_file.name,
    "run_error": run_error,
    "exit_code": int(exit_code),
}
summary_file.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

if [[ "${mode}" == "nightly" ]]; then
  summary_helper="${HOME}/.local/bin/axiom-nightly-summary"
  if [[ -x "${summary_helper}" ]]; then
    nightly_summary="$("${summary_helper}" --limit-notes 6 2>/dev/null || true)"
    if [[ -n "${nightly_summary}" ]]; then
      prompt+=$'\n\nNightly summary snapshot:\n'"${nightly_summary}"
      log "included nightly summary snapshot in prompt"
    else
      log "nightly summary helper returned no output"
    fi
  else
    log "nightly summary helper not found at ${summary_helper}"
  fi
fi

if [[ "${mode}" == "timer" && -x "${schedule_helper}" ]]; then
  if schedule_status="$("${schedule_helper}" due 2>&1)"; then
    log "schedule decision: ${schedule_status}"
  else
    log "schedule decision: ${schedule_status}"
    log "skipping timer wakeup because workload does not justify a run yet"
    exit 0
  fi
fi

run_status=0
if codex exec resume --last "${common_args[@]}" -o "${message_file}" "${prompt}" >"${transcript_file}" 2>&1; then
  log "resumed latest Codex session"
else
  log "resume failed, starting fresh non-interactive run"
  if codex exec "${common_args[@]}" -o "${message_file}" "${prompt}" >"${transcript_file}" 2>&1; then
    log "fresh non-interactive run completed"
  else
    run_status=$?
    log "fresh non-interactive run failed with exit ${run_status}"
  fi
fi

if [[ "${mode}" == "timer" && -x "${schedule_helper}" ]]; then
  record_status="$("${schedule_helper}" record 2>&1 || true)"
  log "schedule record: ${record_status}"
fi

write_structured_summary "${run_status}"
summarize_last_message
log "run complete (status ${run_status})"
exit "${run_status}"
