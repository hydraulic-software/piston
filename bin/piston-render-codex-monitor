    .entry.tool {{ background: var(--tool); color: var(--muted); border-color: var(--tool-line); padding: 4px 7px; }}
    .entry-head {{ display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }}
    .label {{ font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }}
    .time {{ color: var(--muted); font-size: 0.72rem; }}
    .md {{ line-height: 1.32; font-size: 0.92rem; }}
    .md > :first-child {{ margin-top: 0; }}
    .md > :last-child {{ margin-bottom: 0; }}
    .md p {{ margin: 0.18rem 0; }}
    .md pre, .md code {{ font-family: var(--mono); }}
    .md pre {{ white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.78rem; }}
    details {{ margin-top: 0; }}
    summary {{ cursor: pointer; list-style: none; font-size: 0.76rem; }}
    details pre {{ margin: 6px 0 0; padding: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--mono); font-size: 0.76rem; line-height: 1.24; }}
    @keyframes slide-in {{
      from {{ opacity: 0; transform: translateY(-8px); }}
      to {{ opacity: 1; transform: translateY(0); }}
    }}
  </style>
</head>
<body>
  <div class="topbar">
    <span><a href="./">Index</a> / {day}</span>
    <span id="status">Loading…</span>
  </div>
  <main class="wrap">
    <section id="timeline-wrap" class="timeline-wrap"></section>
    <section id="todos"></section>
    <section id="feed" class="feed"></section>
  </main>
  <script>
    const feedEl = document.getElementById('feed');
    const timelineWrapEl = document.getElementById('timeline-wrap');
    const todosEl = document.getElementById('todos');
    const statusEl = document.getElementById('status');
    let signature = '';
    let initialized = false;
    let knownEntryCounts = {{}};
    const openToolGroups = new Set(JSON.parse(localStorage.getItem('piston-open-tool-groups') || '[]'));

    function escapeHtml(text) {{
      return text
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }}

    function renderTimeline(data) {{
      const segments = (data.segments || []).map(seg => `
        <a class="segment-slot" href="${{seg.href}}" title="${{escapeHtml(seg.title)}}" style="left:${{seg.hit_left.toFixed(3)}}%;width:${{seg.hit_width.toFixed(3)}}%">
          <span class="segment ${{seg.kind}} shade-${{seg.shade || 0}}" style="left:${{seg.inner_left.toFixed(3)}}%;width:${{seg.inner_width.toFixed(3)}}%"></span>
        </a>
      `).join('');
      return `
        <div class="timeline">${{segments}}</div>
        <div class="legend">
          <span class="mail">mail</span>
          <span class="autonomy">autonomy</span>
          <span class="other">other</span>
        </div>
      `;
    }}

    function renderSchedules(data) {{
      const schedules = data.schedules || [];
      return `<section class="todos"><div class="todos-head"><h2>Scheduled tasks</h2><span>live recurring schedules</span></div>
        ${{schedules.length ? schedules.map(s => `<article class="todo"><span class="todo-tier">${{escapeHtml(s.cadence)}}</span>
          <div class="todo-body"><div class="todo-text">${{escapeHtml(s.text)}}</div>
          <div class="todo-meta">${{escapeHtml(s.id)}} · next due ${{escapeHtml(s.next_due)}}${{s.occurrence ? ' · ' + escapeHtml(s.occurrence.status + ': ' + s.occurrence.id) : ''}}</div></div></article>`).join('')
          : '<div class="todo-empty">No recurring schedules recorded.</div>'}}</section>`;
    }}

    function renderTodos(data) {{
      const todos = data.todos || [];
      if (!todos.length) {{
        return `
          <section class="todos">
            <div class="todos-head">
              <h2>Todo</h2>
              <span>rolling list</span>
            </div>
            <div class="todo-empty">No open items recorded.</div>
          </section>
        `;
      }}
      return `
        <section class="todos">
          <div class="todos-head">
            <h2>Todo</h2>
            <span>${{todos.length}} active for this day</span>
          </div>
          <div class="todo-list">
            ${{
              todos.map(todo => `
                <article class="todo ${{todo.status}} ${{todo.tier}}">
                  <span class="todo-status">${{escapeHtml(todo.status)}}</span>
                  <span class="todo-tier">${{escapeHtml(todo.tier)}}</span>
                  <div class="todo-body">
                    <div class="todo-text">${{escapeHtml(todo.text)}}</div>
                    ${{todo.progress ? `
                      <div class="todo-progress" title="${{escapeHtml(todo.progress.current + ' of ' + todo.progress.total)}}">
                        <div class="todo-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="${{todo.progress.total}}" aria-valuenow="${{todo.progress.current}}">
                          <div class="todo-progress-fill" style="width:${{todo.progress.percent}}%"></div>
                        </div>
                        <span class="todo-progress-label">${{escapeHtml(todo.progress.label || (todo.progress.current + ' / ' + todo.progress.total))}} · ${{todo.progress.percent}}%</span>
                      </div>
                    ` : ''}}
                  </div>
                  <div class="todo-meta">${{escapeHtml(todo.done_day || todo.updated_day || '')}}</div>
                </article>
              `).join('')
            }}
          </div>
        </section>
      `;
    }}

    function rememberOpenDetails() {{
      openToolGroups.clear();
      document.querySelectorAll('details[data-tool-group][open]').forEach(node => openToolGroups.add(node.dataset.toolGroup));
      localStorage.setItem('piston-open-tool-groups', JSON.stringify([...openToolGroups]));
    }}

    function renderEntry(entry, isNew) {{
      const extraClass = isNew ? ' is-new' : '';
      if (entry.kind === 'tool_group') {{
        const openAttr = openToolGroups.has(entry.id) ? ' open' : '';
        const summary = entry.items.length === 1 ? entry.items[0].summary : (entry.items.length + ' commands');
        const body = entry.items.map(item => `
          <section><div class="entry-head"><span class="label">${{escapeHtml(item.title || 'tool')}}</span>
          <span class="time">${{escapeHtml(item.when || '')}} · ${{escapeHtml(item.result_status || 'result recorded')}}</span></div>
          <div class="todo-meta">Command / action</div><pre>${{escapeHtml(item.details || item.summary)}}</pre>
          <div class="todo-meta">Result</div><pre>${{escapeHtml(item.readable_output ?? item.output ?? '')}}</pre>
          ${{item.output && item.readable_output !== item.output ? `<details><summary>Raw result</summary><pre>${{escapeHtml(item.output)}}</pre></details>` : ''}}</section>`).join('');
        return `
          <article class="entry tool${{extraClass}}">
            <details data-tool-group="${{escapeHtml(entry.id)}}"${{openAttr}}>
              <summary>${{escapeHtml(summary)}}</summary>
              ${{body}}
            </details>
          </article>
        `;
      }}
      return `
        <article class="entry ${{entry.role}}${{extraClass}}">
          <div class="entry-head">
            <span class="label">${{escapeHtml(entry.role)}}</span>
            <span class="time">${{escapeHtml(entry.when)}}</span>
          </div>
          <div class="md">${{entry.html || ''}}</div>
        </article>
      `;
    }}

    function renderWakeup(wakeup, newCount) {{
      const entries = wakeup.display_entries.map((entry, index) => renderEntry(entry, index < newCount)).join('');
      return `
        <section class="wakeup" id="${{escapeHtml(wakeup.id)}}">
          <div class="wakeup-head">
            <div class="wakeup-top">
              <span>${{escapeHtml(wakeup.start_iso)}}</span>
              <span>${{escapeHtml(wakeup.kind)}} • ${{escapeHtml(wakeup.thread_id.slice(0, 8))}}</span>
            </div>
            <p class="headline">${{escapeHtml(wakeup.headline)}}</p>
            ${{wakeup.context ? `<div class="sub">${{escapeHtml(wakeup.context)}}</div>` : ''}}
          </div>
          <div class="entries">${{entries}}</div>
        </section>
      `;
    }}

    async function refresh() {{
      const response = await fetch('./{day}.json?ts=' + Date.now(), {{ cache: 'no-store' }});
      const data = await response.json();
      statusEl.textContent = 'Updated ' + data.generated_at;
      const nextSignature = JSON.stringify([data.generated_at, data.wakeups.length, data.wakeups[0]?.end_iso || '']);
      if (nextSignature === signature) {{
        return;
      }}
      signature = nextSignature;
      const nextCounts = {{}};
      feedEl.classList.add('updating');
      requestAnimationFrame(() => {{
        timelineWrapEl.innerHTML = renderTimeline(data);
        todosEl.innerHTML = renderTodos(data) + renderSchedules(data);
        feedEl.innerHTML = data.wakeups.map(wakeup => {{
          const previous = initialized ? (knownEntryCounts[wakeup.id] || 0) : wakeup.display_entries.length;
          const newCount = Math.max(wakeup.display_entries.length - previous, 0);
          nextCounts[wakeup.id] = wakeup.display_entries.length;
          return renderWakeup(wakeup, newCount);
        }}).join('');
        document.querySelectorAll('details[data-tool-group]').forEach(node => node.addEventListener('toggle', rememberOpenDetails));
        knownEntryCounts = nextCounts;
        initialized = true;
        feedEl.classList.remove('updating');
      }});
    }}

    refresh();
    setInterval(refresh, 5000);
  </script>
</body>
</html>
"""


def write_day(day: dict) -> None:
    payload = {
        "generated_at": dt.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z"),
        "date": day["day"],
        "day": day["day"],
        "segments": day["segments"],
        "todos": day["todos"],
        "schedules": load_schedules(),
        "wakeups": day["wakeups"],
    }
    (OUTPUT_DIR / f"{day['day']}.json").write_text(json.dumps(payload, indent=2, ensure_ascii=False))
    (OUTPUT_DIR / f"{day['day']}.html").write_text(day_shell(day["day"]))


def cleanup(days: list[dict]) -> None:
    keep = {"index.html", "index.json", FAVICON_NAME}
    for day in days:
        keep.add(f"{day['day']}.html")
        keep.add(f"{day['day']}.json")
    for path in OUTPUT_DIR.glob("*"):
        if path.is_file() and path.name not in keep:
            path.unlink()


def main() -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    if "--recent" in sys.argv[1:]:
        local_now = dt.datetime.now().astimezone()
        local_midnight = local_now.replace(hour=0, minute=0, second=0, microsecond=0)
        recent_days = build_days(local_midnight)
        current_days = [day for day in recent_days if day["day"] == local_midnight.strftime("%Y-%m-%d")]
        if not current_days and recent_days:
            # A wakeup can cross midnight. Refresh everything until the first
            # new-day user turn starts so yesterday's final entries are kept.
            write_favicon()
            days = build_days()
            write_index(days)
            for day in days:
                write_day(day)
            cleanup(days)
            return
        for day in current_days:
            if day["day"] == local_midnight.strftime("%Y-%m-%d"):
                write_day(day)
        if not update_index_data(current_days):
            write_favicon()
            days = build_days()
            write_index(days)
            for day in days:
                write_day(day)
            cleanup(days)
        return

    write_favicon()
    days = build_days()
    write_index(days)
    for day in days:
        write_day(day)
    cleanup(days)


if __name__ == "__main__":
    main()
