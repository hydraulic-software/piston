<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{MONITOR_NAME} {day}</title>
  <link rel="icon" type="image/png" href="{FAVICON_NAME}">
  <style>
    :root {{
      --bg: #f4eee2;
