#!/usr/bin/env python3
from __future__ import annotations

import datetime as dt
import json
import os
import sqlite3
import re
import sys
from pathlib import Path

import markdown
try:
    from PIL import Image
except ImportError:
    Image = None


HOME = Path.home()
STATE_DB = Path(os.environ.get("BOT_CODEX_STATE_DB", str(HOME / ".codex" / "state_5.sqlite")))
OUTPUT_DIR = Path(os.environ.get("BOT_MONITOR_OUTPUT_DIR", str(HOME / "private_html")))
AVATAR_SOURCE = Path(
    os.environ.get("BOT_MONITOR_AVATAR", str(HOME / ".local" / "share" / "piston" / "piston-avatar.png"))
)
FAVICON_NAME = os.environ.get("BOT_MONITOR_FAVICON_NAME", "piston-favicon.png")
MONITOR_NAME = os.environ.get("BOT_MONITOR_NAME", "Piston Monitor").strip() or "Piston Monitor"
TODO_FILE = Path(os.environ.get("BOT_TODO_FILE", str(HOME / ".local" / "state" / "piston" / "todo.json")))
RUN_LOG_DIR = Path(os.environ.get("BOT_RUN_LOG_DIR", str(HOME / ".local" / "state" / "piston" / "runs")))
TIMESTAMP_RE = re.compile(rb'"timestamp"\s*:\s*"([^"]+)"')


def load_threads(limit: int = 40) -> list[dict]:
    con = sqlite3.connect(STATE_DB)
    con.row_factory = sqlite3.Row
    cur = con.cursor()
    cur.execute(
        """
        SELECT id, rollout_path, created_at, updated_at, cwd, title, model
        FROM threads
        WHERE archived = 0
          AND agent_nickname IS NULL
          AND agent_role IS NULL
          AND agent_path IS NULL
        ORDER BY updated_at DESC
        LIMIT ?
        """,
        (limit,),
    )
    rows = [dict(row) for row in cur.fetchall()]
    con.close()
    return rows


def iso_to_local_dt(value: str) -> dt.datetime:
    return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone()


def dt_string(value: dt.datetime) -> str:
    return value.strftime("%Y-%m-%d %H:%M:%S %Z")


def short_path(path: str) -> str:
    return path.replace(str(HOME), "~")


def render_markdown(text: str) -> str:
    return markdown.markdown(text, extensions=["extra", "sane_lists", "nl2br"])


def strip_html(text: str) -> str:
    return re.sub(r"<[^>]+>", "", text)


def summarize_text(text: str, max_len: int = 120) -> str:
    flat = " ".join(text.split())
    if len(flat) <= max_len:
        return flat
    return flat[: max_len - 1] + "…"


def first_sentence(text: str, max_len: int = 160) -> str:
    flat = " ".join(text.split())
    if not flat:
        return ""
    match = re.search(r"(.+?[.!?])(?:\s|$)", flat)
    if match:
        return summarize_text(match.group(1), max_len)
    return summarize_text(flat, max_len)


def content_text(value: object) -> str:
    """Flatten Codex's legacy strings and newer typed content blocks for display."""
    if value is None:
        return ""
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        return "".join(content_text(item) for item in value)
    if isinstance(value, dict):
        for key in ("text", "output_text", "input_text"):
            text = value.get(key)
            if isinstance(text, str):
                return text
        return json.dumps(value, indent=2, ensure_ascii=False)
    return str(value)


def rollout_message(obj: dict) -> tuple[str, str, str] | None:
    """Return a normalized (role, phase, text) record for either rollout schema."""
    payload = obj.get("payload", {})
    if obj.get("type") in {"event_msg", None}:
        kind = payload.get("type")
        if kind == "user_message":
            return "user", "", content_text(payload.get("message", ""))
        if kind == "agent_message":
            return "assistant", payload.get("phase", "commentary"), content_text(payload.get("message", ""))
    if obj.get("type") == "response_item" and payload.get("type") == "message":
        role = payload.get("role", "")
        if role in {"user", "assistant"}:
            return role, payload.get("phase", "commentary" if role == "assistant" else ""), content_text(payload.get("content", ""))
    return None


def setup_user_message(text: str) -> bool:
    """Recognize Codex-injected setup context that must not become a wakeup."""
    return (
        "# AGENTS.md instructions for " in text
        or "<environment_context>" in text
        or text.lstrip().startswith("<recommended_plugins>")
    )


def load_schedules() -> list[dict]:
    try:
        payload = json.loads(TODO_FILE.read_text())
    except (OSError, ValueError):
        return []
    result = []
    for schedule in payload.get("schedules", []):
        if not isinstance(schedule, dict):
            continue
        active = next((i for i in payload.get("items", []) if isinstance(i, dict)
                       and i.get("schedule_id") == schedule.get("id") and i.get("status") != "done"), None)
        result.append({"id": str(schedule.get("id", "")), "text": str(schedule.get("text", "")),
                       "cadence": str(schedule.get("cadence", "")), "next_due": str(schedule.get("next_due", "")),
                       "occurrence": None if active is None else {"id": active["id"], "status": active["status"]}})
    return result


def load_todos(day: str) -> list[dict]:
    if not TODO_FILE.exists():
        return []

    try:
        payload = json.loads(TODO_FILE.read_text())
    except Exception:
        return []

    items = []
    for index, item in enumerate(payload.get("items", [])):
        if not isinstance(item, dict):
            continue
        status = str(item.get("status", "pending")).lower()
        if status not in {"pending", "started", "done"}:
            status = "pending"
        tier = str(item.get("tier", "now") or "now").lower()
        if tier not in {"now", "background"}:
            tier = "now"
        done_day = str(item.get("done_day", "") or "")
        if status == "done" and done_day and done_day < day:
            continue
        progress = item.get("progress")
        normalized_progress = None
        if isinstance(progress, dict):
            try:
                current = int(progress.get("current"))
                total = int(progress.get("total"))
            except (TypeError, ValueError):
                pass
            else:
                if total > 0 and 0 <= current <= total:
                    normalized_progress = {
                        "current": current,
                        "total": total,
                        "percent": round(current * 100 / total, 1),
                        "label": str(progress.get("label", "") or "").strip(),
                    }
        items.append(
            {
                "id": item.get("id") or f"todo-{index}",
                "text": str(item.get("text", "")).strip(),
                "status": status,
                "tier": tier,
                "updated_day": str(item.get("updated_day", "") or ""),
                "done_day": done_day,
                "progress": normalized_progress,
            }
        )
    order = {
        ("now", "started"): 0,
        ("now", "pending"): 1,
        ("background", "started"): 2,
        ("background", "pending"): 3,
        ("now", "done"): 4,
        ("background", "done"): 5,
    }
    items = [item for item in items if item["text"]]
    items.sort(key=lambda item: (order.get((item["tier"], item["status"]), 9), item["id"]))
    return items


def load_run_summaries() -> list[dict]:
    summaries = []
    for path in sorted(RUN_LOG_DIR.glob("*.summary.json")):
        match = re.match(r"(\d{8}T\d{6})-(mail|timer|nightly)\.summary\.json$", path.name)
        if not match:
            continue
        try:
            payload = json.loads(path.read_text())
        except Exception:
            continue
        ts = dt.datetime.strptime(match.group(1), "%Y%m%dT%H%M%S").astimezone().timestamp()
        mode = match.group(2)
        kind = {"mail": "mail", "timer": "autonomy", "nightly": "other"}.get(mode, "other")
        summaries.append(
            {
                "path": path,
                "ts": ts,
                "mode": mode,
                "kind": kind,
                "headline": str(payload.get("headline", "") or "").strip(),
                "prompt": str(payload.get("prompt", "") or "").strip(),
            }
        )
    return summaries


def apply_structured_summaries(wakeups: list[dict]) -> None:
    summaries = load_run_summaries()
    used_paths: set[Path] = set()
    for wakeup in sorted(wakeups, key=lambda item: item["start_ts"]):
        candidates = [
            summary
            for summary in summaries
            if summary["path"] not in used_paths
            and summary["kind"] == wakeup["kind"]
            and abs(summary["ts"] - wakeup["start_ts"]) <= 900
        ]
        if not candidates:
            continue
        summary = min(candidates, key=lambda item: abs(item["ts"] - wakeup["start_ts"]))
        used_paths.add(summary["path"])
        headline = summary["headline"]
        if headline:
            wakeup["headline"] = summarize_text(headline, 160)
            wakeup["used_structured_summary"] = True


def write_favicon() -> None:
    if Image is None or not AVATAR_SOURCE.exists():
        return

    img = Image.open(AVATAR_SOURCE).convert("RGBA")
    img.thumbnail((64, 64), Image.Resampling.LANCZOS)
    canvas = Image.new("RGBA", (64, 64), (0, 0, 0, 0))
    left = (64 - img.width) // 2
    top = (64 - img.height) // 2
    canvas.paste(img, (left, top), img)
    canvas.save(OUTPUT_DIR / FAVICON_NAME)


def tool_summary(name: str, body: str) -> str:
    commands = tool_commands(name, body)
    if commands:
        suffix = f" (+{len(commands) - 1} more)" if len(commands) > 1 else ""
        return commands[0] + suffix
    try:
        parsed = json.loads(body)
    except Exception:
        return name
    if name == "parallel":
        return f"parallel ({len(parsed.get('tool_uses', []))} calls)"
    if name == "update_plan":
        return "update plan"
    if name == "apply_patch":
        return "apply patch"
    return name


def tool_commands(name: str, body: str) -> list[str]:
    if name == "exec_command":
        try:
            command = json.loads(body).get("cmd")
            return [command] if isinstance(command, str) else []
        except Exception:
            return []
    if name != "exec":
        return []

    # Newer Codex versions wrap tool calls in JavaScript. Extract literal shell commands so the monitor shows the
    # useful operation instead of only the generic orchestration tool name.
    commands = []
    for match in re.finditer(r"\bcmd\s*:\s*(\"(?:\\.|[^\"\\])*\")", body):
        try:
            commands.append(json.loads(match.group(1)))
        except json.JSONDecodeError:
            continue
    return commands


def pretty_json_string(value: str) -> str:
    try:
        return json.dumps(json.loads(value), indent=2, ensure_ascii=False)
    except Exception:
        return value


def readable_tool_output(raw: str) -> dict:
    """Decode only known result envelopes; ordinary JSON remains ordinary output."""
    parts, metadata = [], []
    decoder = json.JSONDecoder()
    rest = raw.strip()
    envelope = re.search(r'\{"chunk_id"\s*:', rest)
    if envelope and envelope.start() > 0:
        parts.append(rest[:envelope.start()].strip())
        rest = rest[envelope.start():]
    while rest:
        try:
            value, end = decoder.raw_decode(rest)
        except ValueError:
            parts.append(rest)
            break
        if (isinstance(value, dict) and isinstance(value.get("output"), str)
                and any(key in value for key in ("chunk_id", "exit_code", "wall_time_seconds", "session_id"))):
            parts.append(value["output"])
            if value.get("exit_code") is not None:
                metadata.append(f"exit {value['exit_code']}")
            if value.get("wall_time_seconds") is not None:
                metadata.append(f"{value['wall_time_seconds']}s")
            if value.get("session_id") is not None:
                metadata.append(f"running session {value['session_id']}")
        else:
            parts.append(json.dumps(value, indent=2, ensure_ascii=False))
        rest = rest[end:].lstrip()
    return {"text": "\n\n".join(parts), "status": " · ".join(metadata)}


def tool_detail(name: str, body: str) -> str:
    commands = tool_commands(name, body)
    if commands:
        return "\n\n".join(commands)
    try:
        parsed = json.loads(body)
    except Exception:
        return body
    return pretty_json_string(body)


def wakeup_kind(prompt: str) -> str:
    lowered = prompt.lower()
    if "mail" in lowered:
        return "mail"
    if "autonomous" in lowered:
        return "autonomy"
    return "other"


def clean_prompt(prompt: str) -> str:
    lowered = prompt.lower()
    if "you've got mail!" in lowered or "received new mail" in lowered:
        return "Mail check"

    text = " ".join(prompt.split())
    text = re.sub(r"^The time is .*?\.\s*", "", text, count=1)
    if text.startswith("Autonomous check-in:"):
        return "Autonomous check-in"
    if text.startswith("Nightly maintenance wakeup:"):
        return "Nightly maintenance"
    return summarize_text(text, 140)


def recent_rollout_lines(path: Path, since: dt.datetime) -> tuple[list[str], int]:
    """Read only the active-day suffix, anchored at its preceding user turn."""
    since_utc = since.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
    current_turn: list[bytes] = []
    selected_offset = 0
    user_count = 0
    started = False
    selected_has_crossing_turn = False
    selected: list[str] = []
    seen_message_times: dict[tuple[str, str, str], dt.datetime] = {}

    with path.open("rb") as stream:
        for raw in stream:
            try:
                obj = json.loads(raw)
            except (json.JSONDecodeError, UnicodeDecodeError):
                continue
            message = rollout_message(obj)
            match = TIMESTAMP_RE.search(raw)
            timestamp = match.group(1).decode() if match else ""
            is_user_line = False
            if message is not None:
                role, phase, text = message
                if role == "user" and not setup_user_message(text):
                    at = dt.datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
                    key = (role, phase, text)
                    previous = seen_message_times.get(key)
                    if previous is None or abs((at - previous).total_seconds()) > 2:
                        is_user_line = True
                        seen_message_times[key] = at

            if is_user_line:
                user_count += 1
                current_turn = [raw]
            elif current_turn:
                current_turn.append(raw)

            if not started and timestamp[:19] >= since_utc:
                started = True
                selected = [line.decode() for line in current_turn]
                selected_offset = max(user_count - 1, 0)
                if current_turn:
                    first_match = TIMESTAMP_RE.search(current_turn[0])
                    first_timestamp = first_match.group(1).decode() if first_match else ""
                    selected_has_crossing_turn = first_timestamp[:19] < since_utc
            elif started and is_user_line and selected_has_crossing_turn:
                # Once today's first user turn starts, yesterday's crossing
                # turn is complete and no longer belongs in the fast refresh.
                selected = [raw.decode()]
                selected_offset = user_count - 1
                selected_has_crossing_turn = False
            elif started:
                selected.append(raw.decode())

    return selected, selected_offset


def parse_rollout(thread: dict, since: dt.datetime | None = None) -> list[dict]:
    path = Path(thread["rollout_path"])
    if not path.exists():
        return []

    wakeups: list[dict] = []
    current: dict | None = None
    pending_tools: dict[str, dict] = {}
    prelude_entries: list[dict] = []
    prelude_start: dt.datetime | None = None
    seen_message_times: dict[tuple[str, str, str], dt.datetime] = {}

    def append_entry(at: dt.datetime, entry: dict) -> None:
        nonlocal prelude_start
        if current is None:
            if prelude_start is None:
                prelude_start = at
            prelude_entries.append(entry)
        else:
            current["entries"].append(entry)

    def begin_wakeup(prompt: str, at: dt.datetime) -> dict:
        nonlocal current, prelude_entries, prelude_start
        start_at = prelude_start or at
        current = {
            "id": f"{thread['id']}-{wakeup_index_offset + len(wakeups) + 1}",
            "thread_id": thread["id"],
            "thread_title": thread["title"],
            "cwd": short_path(thread["cwd"]),
            "model": thread.get("model") or "unknown",
            "prompt": prompt,
            "kind": wakeup_kind(prompt),
            "start_iso": dt_string(start_at),
            "end_iso": dt_string(at),
            "start_ts": start_at.timestamp(),
            "end_ts": at.timestamp(),
            "day": start_at.strftime("%Y-%m-%d"),
            "entries": prelude_entries,
        }
        wakeups.append(current)
        prelude_entries = []
        prelude_start = None
        return current

    def bootstrap_wakeup() -> None:
        nonlocal current, prelude_entries, prelude_start
        if current is not None or not prelude_entries or prelude_start is None:
            return
        prompt = thread["title"]
        current = {
            "id": f"{thread['id']}-bootstrap",
            "thread_id": thread["id"],
            "thread_title": thread["title"],
            "cwd": short_path(thread["cwd"]),
            "model": thread.get("model") or "unknown",
            "prompt": prompt,
            "kind": wakeup_kind(prompt),
            "start_iso": dt_string(prelude_start),
            "end_iso": dt_string(prelude_start),
            "start_ts": prelude_start.timestamp(),
            "end_ts": prelude_start.timestamp(),
            "day": prelude_start.strftime("%Y-%m-%d"),
            "entries": prelude_entries,
        }
        wakeups.append(current)
        prelude_entries = []
        prelude_start = None

    if since is not None:
        lines, wakeup_index_offset = recent_rollout_lines(path, since)
    else:
        lines = path.read_text().splitlines()
        wakeup_index_offset = 0
    for raw in lines:
        obj = json.loads(raw)
        at = iso_to_local_dt(obj["timestamp"])
        when = dt_string(at)
        event_type = obj.get("type")
        payload = obj.get("payload", {})

        message = rollout_message(obj)
        if message is not None:
            role, phase, text = message
            if role == "user" and setup_user_message(text):
                continue
            key = (role, phase, text)
            previous = seen_message_times.get(key)
            if previous is not None and abs((at - previous).total_seconds()) <= 2:
                continue
            seen_message_times[key] = at
            if role == "user":
                begin_wakeup(text, at)
            else:
                if current is not None:
                    current["end_iso"] = when
                    current["end_ts"] = at.timestamp()
                append_entry(
                    at,
                    {
                        "kind": "message",
                        "role": "final" if phase == "final_answer" else "commentary",
                        "ts": at.timestamp(),
                        "when": when,
                        "html": render_markdown(text),
                        "plain": text,
                    },
                )
            continue

        if event_type == "event_msg":
            kind = payload.get("type")
            if kind == "task_complete":
                continue
        elif event_type == "response_item":
            kind = payload.get("type")
            if current is not None:
                current["end_iso"] = when
                current["end_ts"] = at.timestamp()
            if kind == "reasoning":
                summary = payload.get("summary") or []
                if summary:
                    append_entry(
                        at,
                        {
                            "kind": "reasoning",
                            "role": "reasoning",
                            "ts": at.timestamp(),
                            "when": when,
                            "html": render_markdown("\n".join(summary)),
                            "plain": "\n".join(summary),
                        }
                    )
            elif kind in {"function_call", "custom_tool_call"}:
                title = payload.get("name", kind)
                body = payload.get("arguments") if kind == "function_call" else payload.get("input", "")
                entry = {
                    "kind": "tool",
                    "role": "tool",
                    "ts": at.timestamp(),
                    "when": when,
                    "title": title,
                    "summary": tool_summary(title, body or ""),
                    "details": tool_detail(title, body or ""),
                    "output": "",
                }
                append_entry(at, entry)
                pending_tools[payload.get("call_id", "")] = entry
            elif kind in {"function_call_output", "custom_tool_call_output"}:
                output = content_text(payload.get("output", ""))
                readable = readable_tool_output(output)
                entry = pending_tools.get(payload.get("call_id", ""))
                if entry is None:
                    entry = {
                        "kind": "tool",
                        "role": "tool",
                        "ts": at.timestamp(),
                        "when": when,
                        "title": "tool",
                        "summary": "tool activity",
                        "details": "",
                        "output": output,
                    }
                    append_entry(at, entry)
                else:
                    entry["output"] = output
                    entry["ts"] = at.timestamp()
                    entry["when"] = when
                    entry["summary"] = summarize_text(entry["summary"], 72)
                entry["readable_output"] = readable["text"]
                entry["result_status"] = readable["status"]

    bootstrap_wakeup()

    for wakeup in wakeups:
        latest_ts = max((entry.get("ts", wakeup["start_ts"]) for entry in wakeup["entries"]), default=wakeup["start_ts"])
        wakeup["end_ts"] = max(latest_ts, wakeup["start_ts"] + 60)
        wakeup["end_iso"] = dt_string(dt.datetime.fromtimestamp(wakeup["end_ts"]).astimezone())

    wakeups.sort(key=lambda item: item["start_ts"])
    for index, wakeup in enumerate(wakeups[:-1]):
        next_start = wakeups[index + 1]["start_ts"]
        if wakeup["end_ts"] > next_start:
            wakeup["end_ts"] = next_start
            wakeup["end_iso"] = dt_string(dt.datetime.fromtimestamp(next_start).astimezone())
    for wakeup in wakeups:
        if wakeup["end_ts"] <= wakeup["start_ts"]:
            wakeup["end_ts"] = wakeup["start_ts"] + 60
            wakeup["end_iso"] = wakeup["start_iso"]

    wakeups.sort(key=lambda item: item["start_ts"], reverse=True)
    for wakeup in wakeups:
        display_entries = []
        group_index = 0
        for entry in reversed(wakeup["entries"]):
            if entry["kind"] == "tool":
                if display_entries and display_entries[-1]["kind"] == "tool_group":
                    display_entries[-1]["items"].append(entry)
                else:
                    display_entries.append(
                        {
                            "kind": "tool_group",
                            "id": f"{wakeup['id']}-tools-{group_index}",
                            "items": [entry],
                        }
                    )
                    group_index += 1
            else:
                display_entries.append(entry)
        wakeup["display_entries"] = display_entries
        wakeup["label"] = clean_prompt(wakeup["prompt"])
        final_entry = next((entry for entry in wakeup["entries"] if entry.get("role") == "final"), None)
        tooltip = final_entry.get("plain") if final_entry else None
        if tooltip is None:
            latest_message = next((entry.get("plain") for entry in reversed(wakeup["entries"]) if entry.get("plain")), None)
            tooltip = latest_message or wakeup["label"] or wakeup["prompt"]
        wakeup["tooltip"] = summarize_text(strip_html(tooltip), 120)
        headline_source = final_entry.get("plain") if final_entry else None
        if headline_source is None:
            headline_source = next((entry.get("plain") for entry in wakeup["entries"] if entry.get("plain")), None)
        wakeup["headline"] = first_sentence(strip_html(headline_source or wakeup["label"] or wakeup["prompt"]))
        meta_bits = []
        generic_labels = {"Mail check", "Autonomous check-in", "Nightly maintenance"}
        if wakeup["label"] not in generic_labels and wakeup["label"] != wakeup["headline"]:
            meta_bits.append(wakeup["label"])
        if wakeup["cwd"] != "~":
            meta_bits.append(wakeup["cwd"])
        thread_title = wakeup["thread_title"].strip()
        noisy_thread_title = (
            "maildir" in thread_title.lower()
            or thread_title.startswith("Autonomous check-in:")
            or thread_title.startswith("Nightly maintenance wakeup:")
            or thread_title.startswith("The time is ")
        )
        if thread_title and not noisy_thread_title and thread_title not in {wakeup["prompt"], wakeup["label"], wakeup["headline"]}:
            meta_bits.append(thread_title)
        wakeup["context"] = " • ".join(meta_bits)

    return wakeups


def build_days(since: dt.datetime | None = None) -> list[dict]:
    wakeups: list[dict] = []
    for thread in load_threads():
        wakeups.extend(parse_rollout(thread, since))

    # Summary sidecars are global to the monitor, not per thread. Loading them
    # once avoids tens of thousands of file reads on every refresh.
    apply_structured_summaries(wakeups)
    wakeups.sort(key=lambda item: item["start_ts"], reverse=True)

    day_map: dict[str, list[dict]] = {}
    for wakeup in wakeups:
        day_map.setdefault(wakeup["day"], []).append(wakeup)

    days: list[dict] = []
    for day in sorted(day_map.keys(), reverse=True):
        day_dt = dt.datetime.fromisoformat(day)
        start = day_dt.replace(tzinfo=dt.datetime.now().astimezone().tzinfo)
        segments = []
        timeline_wakeups = sorted(day_map[day], key=lambda item: item["start_ts"])
        for index, wakeup in enumerate(timeline_wakeups):
            left = ((wakeup["start_ts"] - start.timestamp()) / 86400) * 100
            width = max(((wakeup["end_ts"] - wakeup["start_ts"]) / 86400) * 100, 0.35)
            prev_end = timeline_wakeups[index - 1]["end_ts"] if index > 0 else start.timestamp()
            next_start = timeline_wakeups[index + 1]["start_ts"] if index + 1 < len(timeline_wakeups) else start.timestamp() + 86400
            hit_start_ts = prev_end + ((wakeup["start_ts"] - prev_end) / 2)
            hit_end_ts = wakeup["end_ts"] + ((next_start - wakeup["end_ts"]) / 2)
            hit_left = max(((hit_start_ts - start.timestamp()) / 86400) * 100, 0)
            hit_width = min(((hit_end_ts - hit_start_ts) / 86400) * 100, 100 - hit_left)
            if hit_width <= 0:
                hit_left = max(left, 0)
                hit_width = min(width, 100 - hit_left)
            inner_left = ((max(left, hit_left) - hit_left) / hit_width) * 100 if hit_width else 0
            inner_width = min((width / hit_width) * 100, 100) if hit_width else 100
            segments.append(
                {
                    "href": f"#{wakeup['id']}",
                    "left": max(left, 0),
                    "width": min(width, 100),
                    "hit_left": hit_left,
                    "hit_width": hit_width,
                    "inner_left": max(inner_left, 0),
                    "inner_width": max(inner_width, 2),
                    "kind": wakeup["kind"],
                    "shade": index % 2,
                    "title": f"{wakeup['start_iso']} - {wakeup['tooltip']}",
                }
            )
        days.append({"day": day, "wakeups": day_map[day], "segments": segments, "todos": load_todos(day)})
    return days


def index_day(day: dict) -> dict:
    return {
        "day": day["day"],
        "wakeup_count": len(day["wakeups"]),
        "segments": [
            {key: segment[key] for key in ("left", "width", "kind", "shade")}
            for segment in day["segments"]
        ],
    }


def write_index_data(days: list[dict]) -> None:
    payload = {
        "generated_at": dt.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z"),
        "days": [index_day(day) for day in days],
    }
    (OUTPUT_DIR / "index.json").write_text(json.dumps(payload, indent=2, ensure_ascii=False))


def update_index_data(changed_days: list[dict]) -> bool:
    index_path = OUTPUT_DIR / "index.json"
    if not index_path.exists():
        return False
    try:
        payload = json.loads(index_path.read_text())
        existing = {day["day"]: day for day in payload["days"]}
    except (json.JSONDecodeError, KeyError, TypeError):
        return False
    existing.update((day["day"], index_day(day)) for day in changed_days)
    payload["generated_at"] = dt.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")
    payload["days"] = [existing[day] for day in sorted(existing, reverse=True)]
    index_path.write_text(json.dumps(payload, indent=2, ensure_ascii=False))
    return True


def write_index(days: list[dict]) -> None:
    write_index_data(days)
    html = f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{MONITOR_NAME}</title>
  <link rel="icon" type="image/png" href="{FAVICON_NAME}">
  <style>
    body {{ margin: 0; font-family: "IBM Plex Sans", "Segoe UI", sans-serif; background: #f4eee2; color: #1b2428; }}
    .topbar {{ background: #1b2428; color: #f7f2e9; padding: 10px 14px; font-size: 0.9rem; }}
    .wrap {{ max-width: 900px; margin: 0 auto; padding: 14px; display: grid; gap: 10px; }}
    .day-card {{ display: grid; gap: 8px; padding: 12px 14px; border-radius: 14px; background: rgba(255,255,255,0.85); text-decoration: none; color: inherit; border: 1px solid rgba(27,36,40,0.1); }}
    .day-line {{ display: flex; justify-content: space-between; gap: 12px; font-size: 0.95rem; }}
    .day-line span {{ color: #627078; }}
    .timeline {{ position: relative; height: 16px; background: rgba(27,36,40,0.08); overflow: hidden; }}
    .segment {{ position: absolute; top: 0; height: 100%; box-sizing: border-box; border-right: 1px solid rgba(27,36,40,0.14); }}
    .segment.shade-1 {{ filter: brightness(0.88); }}
    .mail {{ background: #ff7a00; }}
    .autonomy {{ background: #00a7d8; }}
    .other {{ background: #ffd400; }}
  </style>
</head>
<body>
  <div class="topbar">{MONITOR_NAME} index</div>
  <main id="days" class="wrap"></main>
  <script>
    const daysEl = document.getElementById('days');
    let signature = '';

    function escapeHtml(text) {{
      return text
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }}

    function renderDay(day) {{
      const segments = day.segments.map(segment =>
        `<span class="segment ${{escapeHtml(segment.kind)}} shade-${{segment.shade}}" ` +
        `style="left:${{segment.left.toFixed(3)}}%;width:${{segment.width.toFixed(3)}}%"></span>`
      ).join('');
      return `<a class="day-card" href="${{escapeHtml(day.day)}}.html">
        <div class="day-line">
          <strong>${{escapeHtml(day.day)}}</strong>
          <span>${{day.wakeup_count}} wakeups</span>
        </div>
        <div class="timeline">${{segments}}</div>
      </a>`;
    }}

    async function refresh() {{
      const response = await fetch('./index.json?ts=' + Date.now(), {{ cache: 'no-store' }});
      const data = await response.json();
      const nextSignature = JSON.stringify([data.generated_at, data.days.length]);
      if (nextSignature === signature) return;
      signature = nextSignature;
      daysEl.innerHTML = data.days.map(renderDay).join('');
    }}

    refresh();
    setInterval(refresh, 5000);
  </script>
</body>
</html>
"""
    (OUTPUT_DIR / "index.html").write_text(html)


