#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
from datetime import datetime, timedelta
from pathlib import Path


HOME = Path.home()
WORKTREE_ROOTS = {
    "product": HOME / "product",
    "corp": HOME / "corp",
}
PRODUCT_TEAMCITY_BUILD_TYPE = "Product_Axiom_ProductLinux"
TEAMCITY_HELPER = HOME / ".local" / "bin" / "axiom-teamcity-watch"
TEAMCITY_MISSING_BUILD_GRACE = timedelta(days=21)


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, check=check, text=True, capture_output=True)


def branch_commit_at(repo_root: Path, branch: str) -> datetime | None:
    result = run("git", "-C", str(repo_root), "log", "-1", "--format=%cI", branch, check=False)
    stamp = result.stdout.strip()
    if result.returncode != 0 or not stamp:
        return None
    return datetime.fromisoformat(stamp)


def parse_worktrees(repo_name: str, repo_root: Path) -> list[dict]:
    result = run("git", "-C", str(repo_root), "worktree", "list", "--porcelain")
    records = []
    current: dict[str, str] = {}
    for line in result.stdout.splitlines():
        if not line:
            if current:
                records.append(current)
                current = {}
            continue
        key, _, value = line.partition(" ")
        current[key] = value
    if current:
        records.append(current)

    items = []
    for record in records:
        path = record.get("worktree", "")
        branch_ref = record.get("branch", "")
        if not path or Path(path) == repo_root:
            continue
        if not branch_ref.startswith("refs/heads/axiom/"):
            continue
        branch = branch_ref.removeprefix("refs/heads/")
        commit_at = branch_commit_at(repo_root, branch)
        items.append(
            {
                "repo": repo_name,
                "path": path,
                "branch": branch,
                "review_branch": f"rr/{branch}",
                "branch_commit_at": commit_at.isoformat() if commit_at else None,
            }
        )
    return items


def remote_refs(repo_root: Path) -> set[str]:
    result = run("git", "-C", str(repo_root), "for-each-ref", "refs/remotes", "--format=%(refname:short)")
    return {line.strip() for line in result.stdout.splitlines() if line.strip()}


def latest_teamcity_summary(review_branch: str) -> dict | None:
    if not TEAMCITY_HELPER.exists():
        return None
    result = run(
        str(TEAMCITY_HELPER),
        "--build-type",
        PRODUCT_TEAMCITY_BUILD_TYPE,
        "--branch",
        review_branch,
        "--latest",
        check=False,
    )
    if result.returncode == 4:
        return None
    line = result.stdout.strip().splitlines()[0] if result.stdout.strip() else result.stderr.strip().splitlines()[0]
    if not line:
        return None
    pieces = [part.strip() for part in line.split("|")]
    payload = {"summary": line}
    for piece in pieces:
        if "=" not in piece:
            continue
        key, value = piece.split("=", 1)
        payload[key.strip()] = value.strip()
    return payload


def branch_is_recent(item: dict) -> bool:
    stamp = item.get("branch_commit_at")
    if not stamp:
        return True
    return datetime.now().astimezone() - datetime.fromisoformat(stamp) <= TEAMCITY_MISSING_BUILD_GRACE


def build_items() -> list[dict]:
    items = []
    for repo_name, repo_root in WORKTREE_ROOTS.items():
        refs = remote_refs(repo_root)
        for item in parse_worktrees(repo_name, repo_root):
            review_branch = item["review_branch"]
            matching_refs = sorted(ref for ref in refs if ref.endswith(f"/{review_branch}"))
            followup = []
            score = 25
            teamcity = None

            if not matching_refs:
                score = 70
                followup.append("review branch is not pushed to a remote yet")
            else:
                item["remote_refs"] = matching_refs

            if repo_name == "product" and matching_refs:
                teamcity = latest_teamcity_summary(review_branch)
                if teamcity is None:
                    if branch_is_recent(item):
                        score = max(score, 55)
                        followup.append("no TeamCity build found for the review branch")
                    else:
                        item["teamcity_note"] = "no retained TeamCity build found for this older review branch"
                else:
                    item["teamcity"] = teamcity
                    status = teamcity.get("status")
                    state = teamcity.get("state")
                    if status != "SUCCESS" or state != "finished":
                        score = max(score, 80)
                        followup.append(f"TeamCity build is {state}/{status}")

            item["score"] = score
            item["needs_followup"] = bool(followup)
            item["followup"] = followup
            items.append(item)

    items.sort(key=lambda item: (-item["score"], item["repo"], item["branch"]))
    return items


def cmd_json(_args: argparse.Namespace) -> int:
    print(json.dumps({"generated_at": datetime.now().astimezone().isoformat(), "items": build_items()}, indent=2, ensure_ascii=False))
    return 0


def cmd_list(_args: argparse.Namespace) -> int:
    items = build_items()
    if not items:
        print("No active review worktrees.")
        return 0
    for item in items:
        status = "needs-followup" if item["needs_followup"] else "stable"
        tail = ""
        if item.get("teamcity"):
            tail = f" | TeamCity {item['teamcity'].get('state')}/{item['teamcity'].get('status')}"
        if item["followup"]:
            tail += f" | {item['followup'][0]}"
        print(f"{item['score']:>3}  {status:<14}  {item['repo']:<7}  {item['branch']}{tail}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Inspect active review worktrees and latest CI state.")
    sub = parser.add_subparsers(dest="command", required=True)

    p_json = sub.add_parser("json", help="Print review follow-up data as JSON")
    p_json.set_defaults(func=cmd_json)

    p_list = sub.add_parser("list", help="Print review follow-up data as text")
    p_list.set_defaults(func=cmd_list)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
