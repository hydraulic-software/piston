[Unit]
Description=Publish private HTML monitor for Codex sessions

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=-%h/.config/bot-tools/environment
EnvironmentFile=-%h/.config/piston/environment
ExecStart=%h/.local/bin/piston-watch-codex-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
