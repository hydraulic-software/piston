# Copy to ~/.config/piston/environment and adjust for your account.
# systemd EnvironmentFile syntax is KEY=value, not shell syntax.

# Optional: omit this to use the Codex CLI's configured default model.
# BOT_CODEX_MODEL=your-model-name

# Leave disabled unless this is a dedicated, externally isolated account.

# Sender identity used by piston-send-markdown-mail.
BOT_MAIL_FROM="Assistant <assistant@example.com>"
BOT_ENVELOPE_FROM=assistant@example.com
# Optional disclosure appended as a subtle HTML footer and plain-text signature.
# BOT_MAIL_SIGNATURE="R. Example, AI employee."

# Optional overrides.
# BOT_SENDMAIL=/usr/sbin/sendmail
# BOT_ALLOWED_FROM_DOMAINS=example.com
# BOT_MAIL_FILTER_DOMAINS_FILE=/home/assistant/.config/piston/mail-filter-domains.txt
# BOT_MAILDIR=/home/assistant/Maildir
# BOT_MAIL_FILTER_LOG=/home/assistant/.local/state/piston/mail-filter.log
# Require a trusted local Authentication-Results header whose passing DKIM
# signing domain exactly matches the visible From domain.
# BOT_REQUIRE_ALIGNED_DKIM=1
# BOT_AUTH_RESULTS_ID=mail.example.com
# Optionally accept same-host Postfix submissions only when the trusted top
# Received hop identifies a Unix UID whose username exactly matches From.
# BOT_TRUST_LOCAL_SUBMISSION=1
# BOT_LOCAL_MAIL_DOMAIN=hq.example.com
# BOT_TODO_FILE=/home/assistant/.local/state/piston/todo.json
# BOT_AUTONOMY_STATE_FILE=/home/assistant/.local/state/piston/autonomy-schedule.json
# BOT_RUN_LOG_DIR=/home/assistant/.local/state/piston/runs
# BOT_CODEX_STATE_DB=/home/assistant/.codex/state_5.sqlite
# BOT_MONITOR_OUTPUT_DIR=/home/assistant/private_html
# BOT_MONITOR_NAME="R. Example Monitor"
# BOT_MONITOR_AVATAR=/home/assistant/.local/share/piston/piston-avatar.png
# TEAMCITY_BASE_URL=https://teamcity.example.com
# TEAMCITY_API_KEY=replace-with-account-local-secret
